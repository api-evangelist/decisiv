<?xml version="1.0" encoding="UTF-8"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema" elementFormDefault="qualified"
           xmlns:ct="http://www.decisiv.net/platform_api/0.0.7/Case/CaseTypes"
           xmlns:g="http://www.decisiv.net/platform_api/0.0.7/Case/GroupedUser"
           xmlns:eit="http://www.decisiv.net/platform_api/0.0.7/Case/EstimateItemTypes"
           xmlns:e="http://www.decisiv.net/platform_api/0.0.7/Case/EstimateItemRequest"
           targetNamespace="http://www.decisiv.net/platform_api/0.0.7/Case/EstimateItemRequest">
  <xs:import namespace="http://www.decisiv.net/platform_api/0.0.7/Case/CaseTypes"
             schemaLocation="CaseTypes.xsd"/>
  <xs:import namespace="http://www.decisiv.net/platform_api/0.0.7/Case/GroupedUser"
             schemaLocation="GroupedUser.xsd"/>
  <xs:import namespace="http://www.decisiv.net/platform_api/0.0.7/Case/EstimateItemTypes"
             schemaLocation="EstimateItemTypes.xsd"/>
  <xs:element name="item" type="e:EstimateItem"/>
  <xs:complexType name="EstimateItem">
    <xs:all>
      <xs:element name="code" type="xs:string"/>
      <xs:element name="name" type="xs:string"/>
      <xs:element name="standardOperationNotes" type="xs:string" minOccurs="0" nillable="true"/>
      <xs:element name="complaint" type="xs:string" minOccurs="0" nillable="true"/>
      <xs:element name="cause" type="xs:string" minOccurs="0" nillable="true"/>
      <xs:element name="correction" type="xs:string"  minOccurs="0" nillable="true"/>
      <xs:element name="jobCode" type="xs:string"  minOccurs="0" nillable="true"/>
      <xs:element name="priceCode" type="xs:string"  minOccurs="0" nillable="true"/>
      <xs:element name="workStatus" type="eit:WorkStatus" minOccurs="0"/>
      <xs:element name="assignee" type="g:GroupedUser" minOccurs="0" nillable="true"/>
      <xs:element name="approvalStatus" type="eit:ApprovalStatus" minOccurs="0"/>
      <xs:element name="underWarranty" type="xs:boolean" minOccurs="0"/>
      <xs:element name="billingClassification" type="eit:BillingClassification" minOccurs="0" nillable="true"/>
      <xs:element name="labor" type="eit:LaborDetail" minOccurs="0"/>
      <xs:element name="VMRS" type="eit:VMRS" minOccurs="0"/>
      <xs:element name="fixedPriceTotal" type="ct:Currency" minOccurs="0"/>
    </xs:all>
  </xs:complexType>
</xs:schema>
