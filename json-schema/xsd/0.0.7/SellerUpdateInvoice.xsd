<xs:schema attributeFormDefault="unqualified" elementFormDefault="qualified" targetNamespace="http://www.decisiv.net/platform_api/0.0.7/Invoices/SellerUpdateInvoice" xmlns:xs="http://www.w3.org/2001/XMLSchema">
  <xs:element name="seller-update-invoice">
    <xs:complexType>
      <xs:all>
        <xs:element name="customer" nillable="true" minOccurs="0">
          <xs:complexType>
            <xs:all>
              <xs:element type="xs:string" name="name"/>
              <xs:element type="xs:string" name="tag"/>
            </xs:all>
          </xs:complexType>
        </xs:element>
        <xs:element name="due-on" nillable="true" minOccurs="0">
          <xs:complexType>
            <xs:simpleContent>
              <xs:extension base="xs:date">
                <xs:attribute type="xs:string" name="type"/>
              </xs:extension>
            </xs:simpleContent>
          </xs:complexType>
        </xs:element>
        <xs:element name="issued-at" nillable="true" minOccurs="0">
          <xs:complexType>
            <xs:simpleContent>
              <xs:extension base="xs:dateTime">
                <xs:attribute type="xs:string" name="type"/>
                <xs:attribute type="xs:string" name="nil" use="optional"/>
              </xs:extension>
            </xs:simpleContent>
          </xs:complexType>
        </xs:element>
        <xs:element name="lines" nillable="true" minOccurs="0">
          <xs:complexType>
            <xs:sequence>
              <xs:element name="line">
                <xs:complexType>
                  <xs:all>
                    <xs:element name="connections" nillable="true" minOccurs="0">
                      <xs:complexType>
                        <xs:sequence>
                          <xs:element name="connection" maxOccurs="unbounded" minOccurs="0">
                            <xs:complexType>
                              <xs:all>
                                <xs:element type="xs:string" name="relationship"/>
                                <xs:element type="xs:string" name="tag"/>
                                <xs:element name="url" nillable='true'>
                                  <xs:complexType>
                                    <xs:simpleContent>
                                      <xs:extension base="xs:string">
                                        <xs:attribute type="xs:string" name="nil" use="optional"/>
                                      </xs:extension>
                                    </xs:simpleContent>
                                  </xs:complexType>
                                </xs:element>
                              </xs:all>
                            </xs:complexType>
                          </xs:element>
                        </xs:sequence>
                        <xs:attribute type="xs:string" name="type"/>
                      </xs:complexType>
                    </xs:element>
                    <xs:element type="xs:string" name="description"/>
                    <xs:element name="measurement" nillable="true" minOccurs="0">
                      <xs:complexType>
                        <xs:all>
                          <xs:element name="final">
                            <xs:complexType>
                              <xs:simpleContent>
                                <xs:extension base="xs:decimal">
                                  <xs:attribute type="xs:string" name="type"/>
                                </xs:extension>
                              </xs:simpleContent>
                            </xs:complexType>
                          </xs:element>
                          <xs:element name="initial">
                            <xs:complexType>
                              <xs:simpleContent>
                                <xs:extension base="xs:decimal">
                                  <xs:attribute type="xs:string" name="type"/>
                                </xs:extension>
                              </xs:simpleContent>
                            </xs:complexType>
                          </xs:element>
                          <xs:element type="xs:string" name="unit"/>
                        </xs:all>
                      </xs:complexType>
                    </xs:element>
                    <xs:element name="quantity">
                      <xs:complexType>
                        <xs:simpleContent>
                          <xs:extension base="xs:decimal">
                            <xs:attribute type="xs:string" name="type"/>
                          </xs:extension>
                        </xs:simpleContent>
                      </xs:complexType>
                    </xs:element>
                    <xs:element type="xs:string" name="tag"/>
                    <xs:element name="total" nillable="true" minOccurs="0">
                      <xs:complexType>
                        <xs:simpleContent>
                          <xs:extension base="xs:decimal">
                            <xs:attribute type="xs:string" name="type"/>
                          </xs:extension>
                        </xs:simpleContent>
                      </xs:complexType>
                    </xs:element>
                    <xs:element name="unit-price">
                      <xs:complexType>
                        <xs:simpleContent>
                          <xs:extension base="xs:decimal">
                            <xs:attribute type="xs:string" name="type"/>
                          </xs:extension>
                        </xs:simpleContent>
                      </xs:complexType>
                    </xs:element>
                    <xs:element name="unit-tax">
                      <xs:complexType>
                        <xs:simpleContent>
                          <xs:extension base="xs:decimal">
                            <xs:attribute type="xs:string" name="type"/>
                          </xs:extension>
                        </xs:simpleContent>
                      </xs:complexType>
                    </xs:element>
                    <xs:element name="vmrs" nillable="true" minOccurs="0">
                      <xs:complexType>
                        <xs:all>
                          <xs:element type="xs:string" name="code14"/>
                          <xs:element type="xs:string" name="code15"/>
                          <xs:element type="xs:string" name="code33"/>
                        </xs:all>
                      </xs:complexType>
                    </xs:element>
                  </xs:all>
                </xs:complexType>
              </xs:element>
            </xs:sequence>
            <xs:attribute type="xs:string" name="type"/>
          </xs:complexType>
        </xs:element>
        <xs:element type="xs:string" name="number" nillable="true" minOccurs="0"/>
        <xs:element type="xs:string" name="po-number" nillable="true" minOccurs="0"/>
      </xs:all>
    </xs:complexType>
  </xs:element>
</xs:schema>
