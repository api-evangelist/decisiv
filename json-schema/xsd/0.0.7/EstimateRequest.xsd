<?xml version="1.0" encoding="UTF-8"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema" elementFormDefault="qualified"
           xmlns:ct="http://www.decisiv.net/platform_api/0.0.7/Case/CaseTypes"
           xmlns:e="http://www.decisiv.net/platform_api/0.0.7/Case/EstimateRequest"
           targetNamespace="http://www.decisiv.net/platform_api/0.0.7/Case/EstimateRequest">
  <xs:import namespace="http://www.decisiv.net/platform_api/0.0.7/Case/CaseTypes"
             schemaLocation="CaseTypes.xsd"/>
  <xs:element name="estimate" type="e:Estimate"/>
  <xs:complexType name="Estimate">
    <xs:all>
      <xs:element name="shopSupplies" type="ct:Currency"/>
      <xs:element name="hazWaste" type="ct:Currency"/>
      <xs:element name="freight" type="ct:Currency"/>
      <xs:element name="tax" type="ct:Currency"/>
    </xs:all>
  </xs:complexType>
</xs:schema>
