<?xml version="1.0" encoding="UTF-8"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema" elementFormDefault="qualified"
    xmlns:d="http://www.decisiv.net/platform_api/0.2/Case/Department"  targetNamespace="http://www.decisiv.net/platform_api/0.2/Case/ServiceLocationDepartments">
    <xs:import namespace="http://www.decisiv.net/platform_api/0.2/Case/Department"
        schemaLocation="Department.xsd"/>
    <xs:element name="department" type="d:Department"></xs:element>
    <xs:element name="departments">
        <xs:complexType>
            <xs:sequence>
                <xs:element name="department" type="d:Department" maxOccurs="unbounded" minOccurs="0"/>
            </xs:sequence>
        </xs:complexType>
    </xs:element>
</xs:schema>
