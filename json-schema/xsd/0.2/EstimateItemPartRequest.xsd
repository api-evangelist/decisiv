<?xml version="1.0" encoding="UTF-8"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema" elementFormDefault="qualified"
           xmlns:ct="http://www.decisiv.net/platform_api/0.2/Case/CaseTypes"
           xmlns:e="http://www.decisiv.net/platform_api/0.2/Case/EstimateItemPartRequest"
           targetNamespace="http://www.decisiv.net/platform_api/0.2/Case/EstimateItemPartRequest">
  <xs:import namespace="http://www.decisiv.net/platform_api/0.2/Case/CaseTypes"
             schemaLocation="CaseTypes.xsd"/>
  <xs:element name="part" type="e:EstimateItemPart"/>
  <xs:complexType name="EstimateItemPart">
    <xs:all>
      <xs:element name="id" type="xs:integer" minOccurs="0"/>
      <xs:element name="name" type="xs:string"/>
      <xs:element name="partNumber" type="xs:string"/>
      <xs:element name="quantity" type="xs:decimal"/>
      <xs:element name="quantityShipped" type="xs:integer" minOccurs="0"/>
      <xs:element name="quantityBackordered" type="xs:integer" minOccurs="0"/>
      <xs:element name="unitPrice" type="ct:Currency"/>
      <xs:element name="coreQuantity" type="xs:decimal"/>
      <xs:element name="unitCorePrice" type="ct:Currency"/>
    </xs:all>
  </xs:complexType>
</xs:schema>
