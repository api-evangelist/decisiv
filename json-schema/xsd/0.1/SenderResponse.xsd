<?xml version="1.0" encoding="UTF-8"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema" elementFormDefault="qualified"
    xmlns:s="http://www.decisiv.net/platform_api/0.1/Case/SenderResponse"
    xmlns:ct="http://www.decisiv.net/platform_api/0.1/Case/CaseTypes"  targetNamespace="http://www.decisiv.net/platform_api/0.1/Case/SenderResponse">
    <xs:import namespace="http://www.decisiv.net/platform_api/0.1/Case/CaseTypes"
        schemaLocation="CaseTypes.xsd"/>
    <xs:element name="senders">
        <xs:complexType>
            <xs:sequence>
                <xs:element name="sender" type="s:Sender" maxOccurs="unbounded" minOccurs="0"/>
            </xs:sequence>
        </xs:complexType>
    </xs:element>
    <xs:element name="sender" type="s:Sender"/>
    <xs:complexType name="Sender">
        <xs:all>
          <xs:element name="id" type="xs:string"/>
          <xs:element name="name" type="xs:string" minOccurs="0"/>
          <xs:element name="groupName" type="xs:string" minOccurs="0"/>
          <xs:element name="URL" type="xs:string" minOccurs="0"/>
        </xs:all>
    </xs:complexType>
</xs:schema>
